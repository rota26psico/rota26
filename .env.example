# ═══════════════════════════════════════════════════════════════════════════
# AMBIENTE DA APLICAÇÃO
# ═══════════════════════════════════════════════════════════════════════════
# 'production'  → aplicação organizacional com dados reais (PADRÃO).
# 'development' → ambiente de desenvolvimento.
#
# O padrão é production: variável ausente, esquecida ou com valor inválido
# resulta em PRODUÇÃO, nunca em demonstração.
NEXT_PUBLIC_APP_MODE=production

# Trava do gerador de dados fictícios. Só tem efeito quando
# NEXT_PUBLIC_APP_MODE=development. Em produção é ignorada.
# Deixe ausente (ou 'false') em qualquer ambiente de aplicação real.
# PERMITIR_SEED_DEMO=false

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Somente para rotas de servidor e scripts administrativos. NUNCA exponha
# esta chave no cliente e NUNCA a versione.
# Usada pela rota /api/preparar, que precisa gravar o registro temporário de
# validação (is_test) em nome de outro participante — algo que o RLS,
# corretamente, impede um administrador de fazer pela chave anônima.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
